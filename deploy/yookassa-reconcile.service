[Unit]
Description=Reconcile YooKassa wellness payments
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
EnvironmentFile=/etc/mirror/yookassa-reconcile.env
ExecStart=/usr/bin/python3 /var/www/mirror/deploy/yookassa-reconcile.py --apply
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
